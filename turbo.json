{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "tasks": {
    "compile": {
      "cache": false
    },
    "build": {
      "dependsOn": [
        "^build",
        "^compile"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "biome:check": {
      "dependsOn": [
        "^biome:check"
      ]
    },
    "typescript:check": {
      "dependsOn": [
        "^typescript:check"
      ]
    }
  }
}
